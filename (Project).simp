                            <tagged-value id="tvaafb1d4535d94847967477205c7c1146" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\World\HexMap.cs" />
                            <tagged-value id="tv818ebdcf57ad4a26a28bdd70a73a0821" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvf40b6095f8aa46d287a2fd61119ae2e4" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="865" />
                            <tagged-value id="tv0f2db29061e9483e9cfe17b5a4dce1d9" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="179" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        Get(center)?.Discover();
        foreach (HexCoordinate neighbor in center.Neighbors()) Get(neighbor)?.Reveal();
    </source-code>
                          </source-codes>
                        </operation>
