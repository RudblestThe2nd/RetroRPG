                          </tagged-values>
                          <documentations>
                            <doc id="fac40b3fe9af4bac910c705acd5c2171">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Aktif görevlerin haritadaki hedefleri. Düşman ve tehlike işareti burada yoktur.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (!UsesMainStory(session)) return [];
        return session.Story.Quests.Values
            .Where(x =&gt; x.Status == QuestStatus.Active)
            .SelectMany(x =&gt; x is WaystoneQuest || x is SideQuest
                ? x.Objectives.Where(o =&gt; !x.IsObjectiveDone(o.Id))
                : x.ActiveObjective is QuestObjective active ? [active] : [])
            .Where(x =&gt; x.Site is not null)
            .GroupBy(x =&gt; x.Site!.Value)
            .Select(x =&gt; new StoryMarker(x.Key, x.First().Label))
            .ToArray();
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
