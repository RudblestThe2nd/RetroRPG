                        <operation id="oc34307b6b08644db8f6e2ca43a24c72366" cid="OP043" name="Load" creation-date="11/04/2026 08:41:07" type="CharacterAtlasRuntime" type-id="Class:cd7ab9668ea54e4a9709b7a664db1f96" visibility="public" static="true">
                          <parameters>
                            <parameter id="p02e7f392e8104ce38f784d0bec2cc1e5" name="manifestPath" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pf3eba731872c4de2b9ab968beaf5f2e9" name="runtimeRoot" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv3314abd062c945449ac7c743c8834926" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Load" />
                            <tagged-value id="tv0d2a964e00854cec939ee8bdeb677157" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\CharacterAtlasRuntime.cs" />
                            <tagged-value id="tv2aeeeba67d964028a8e3c499e1793f54" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv33be77a6eb8a462b97e2ecde9f088c70" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1211" />
                            <tagged-value id="tv6201d2bb39f74b2c9e8782671c7884fb" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="386" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        RuntimeAtlasManifest manifest = JsonSerializer.Deserialize&lt;RuntimeAtlasManifest&gt;(File.ReadAllText(manifestPath), JsonOptions.Default)
            ?? throw new InvalidDataException("Karakter atlas manifesti okunamadı.");
        return new CharacterAtlasRuntime(manifest, runtimeRoot);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o5524855274e3471a81ccaa8119b0a6da66" cid="OP044" name="Select" creation-date="11/04/2026 08:41:07" type="RuntimeFrame" type-id="Class:8796fe1560fe4fd295b9aafc40b03a2d" visibility="public">
                          <parameters>
                            <parameter id="p9d946f72ae2b43fc810e4cbc8f8c5e67" name="animation" type="CharacterAnimation" type-id="CharacterAnimation" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p236fb6ce978a404eb36efd7e6e9c5522" name="direction" type="Direction" type-id="Direction" creation-date="11/04/2026 08:41:07" />
                            <parameter id="peae60cef5c1f48e7b8265b55ee8463ae" name="frameIndex" type="int" type-id="CSharp.int" default-value="0" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tva2067a8499d44d34b0f002be0b3d4d05" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Select" />
                            <tagged-value id="tvb3c4f9e3d45e445ca7b7c205ccb9a0b8" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\CharacterAtlasRuntime.cs" />
                            <tagged-value id="tv130af52cfb78480db8e5f1208e87b173" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvf6cd5a85ad264b44add0c80fd4b12b21" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1603" />
                            <tagged-value id="tve98e2f36aec74ef3932b4262b6325703" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="470" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        RuntimeFrame[] matches = _manifest.Frames
            .Where(x =&gt; x.Animation == animation &amp;&amp; x.Direction == direction)
            .OrderBy(x =&gt; x.AnimationFrame).ToArray();
        if (matches.Length == 0) throw new KeyNotFoundException($"Animasyon karesi yok: {animation}/{direction}");
        return matches[Math.Abs(frameIndex) % matches.Length];
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o6dc4eb89b8f34f028de107c192fad0c166" cid="OP045" name="ResolvePath" creation-date="11/04/2026 08:41:07" type="string" type-id="CSharp.string" visibility="public">
                          <parameters>
                            <parameter id="pa07bde47f74c43cc8ff24d92c822a616" name="frame" type="RuntimeFrame" type-id="RuntimeFrame" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvcc6cac878b9140bcb452113339b46bd9" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="ResolvePath" />
                            <tagged-value id="tv0bab26b4dbd345b0ac9430000d10fd78" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\CharacterAtlasRuntime.cs" />
                            <tagged-value id="tv38ccc0813ffa41c687433153548bf5ea" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv866cf2063a184c1f8309fee91b5f432c" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2079" />
                            <tagged-value id="tvf9614cc398b34a78a6d7bdf8b859468a" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="357" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string path = Path.GetFullPath(Path.Combine(_runtimeRoot, frame.RuntimePath));
        if (!path.StartsWith(_runtimeRoot, StringComparison.OrdinalIgnoreCase) || !File.Exists(path))
            throw new FileNotFoundException("Runtime karakter karesi bulunamadı.", path);
        return path;
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
