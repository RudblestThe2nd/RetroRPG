                            <tagged-value id="tv6997d5c773b5427cab85b299c28361f7" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Items\Item.cs" />
