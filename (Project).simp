                      <owned-items />
                      <attributes>
                        <attribute id="a9c433762938a49c88e8779049f8a1b8f118" cid="PROP404" name="_profiles" creation-date="11/04/2026 08:41:07" property-ref="e85b37de9c31487896cf9df338b21db8" />
                        <attribute id="a9ca4a2e5353d4a3697bf2275a42bc478119" cid="PROP405" name="Profiles" creation-date="11/04/2026 08:41:07" property-ref="e4ab0cce1d8141a6aac47558bcaa5d28" />
                      </attributes>
                      <operations>
                        <operation id="o7e6576a40d4b4c22aef41ca3ba83f06b119" cid="OP085" name="Load" creation-date="11/04/2026 08:41:07" type="EquipmentAnchorCatalog" type-id="Class:8542d632de1341168fd9f18ef214e3ec" visibility="public" static="true">
                          <parameters>
                            <parameter id="p06886dc54ed34c74affe908068dd3b88" name="manifestPath" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvacd30d51f7504278bf9d30cdbc3d40ba" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Load" />
                            <tagged-value id="tv77db88f908144d208376ec269ee4e127" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\EquipmentAnchorCatalog.cs" />
                            <tagged-value id="tv0b476f5d0743449aa2bee467a314800d" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv8e2a711291b545dd834b115240606e2a" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="537" />
                            <tagged-value id="tv6c7fcf52eda94be3ab8ff4ae013f4ded" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="948" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        using JsonDocument document = JsonDocument.Parse(File.ReadAllText(manifestPath));
        JsonElement profiles = document.RootElement.GetProperty("anchor_profiles");
        var catalog = new EquipmentAnchorCatalog();
        foreach (JsonProperty profile in profiles.EnumerateObject())
        {
            JsonElement value = profile.Value;
            var hands = new Dictionary&lt;Direction, RuntimePoint&gt;();
            foreach (JsonProperty hand in value.GetProperty("hand").EnumerateObject())
                hands[Enum.Parse&lt;Direction&gt;(hand.Name, true)] = Point(hand.Value);
            catalog._profiles[profile.Name] = new EquipmentAnchorProfile(
                hands, Point(value.GetProperty("head")), Point(value.GetProperty("torso")),
                Point(value.GetProperty("feet")), Point(value.GetProperty("back")));
        }
        return catalog;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o26504eec5c714ce0bf01872dda394859119" cid="OP086" name="For" creation-date="11/04/2026 08:41:07" type="EquipmentAnchorProfile" type-id="Class:a4775c1fcba1478ca746e832fc5dfb43" visibility="public">
                          <parameters>
                            <parameter id="pf511df3c06634baba254cd9807dcdf25" name="raceId" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p41cfe32624f74905924dfc6ea8f24e7b" name="gender" type="Gender" type-id="Gender" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvb4c77800154a495f97213a0a8efbb28f" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="For" />
                            <tagged-value id="tv44825b81515042d3891671e8940cb2c7" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\EquipmentAnchorCatalog.cs" />
                            <tagged-value id="tva429ad9b6e724284a82255b1c714ba37" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv65809d98692642988327955ebfc23ba6" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1491" />
                            <tagged-value id="tvcebf36babdc445fdb734d0926b2d669e" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="328" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string key = $"{raceId}-{gender.ToString().ToLowerInvariant()}";
        return _profiles.TryGetValue(key, out EquipmentAnchorProfile? profile)
            ? profile : throw new KeyNotFoundException($"Ekipman ankraj profili bulunamadı: {key}");
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
