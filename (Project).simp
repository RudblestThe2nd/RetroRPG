                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvea16c3e843634214a9007ed0afc56e0d" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Markers" />
                            <tagged-value id="tv9a578cb3e225482e9cf42bf44766caf7" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryDirector.cs" />
                            <tagged-value id="tv5fc9b7ec517b454cb7703e448e0c4795" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
