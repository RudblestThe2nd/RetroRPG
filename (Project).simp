                        <operation id="o52228e7411d741c79ca1c879c927dd8f121" cid="OP091" name="Create" creation-date="11/04/2026 08:41:07" type="BiomeEnemyNpc" type-id="Class:ce17b706e794446d97770b16ca1d68bd" visibility="public" static="true">
                          <parameters>
                            <parameter id="p6d28d279a8814c45b98c492710cedae6" name="enemy" type="EnemyDefinition" type-id="EnemyDefinition" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv0b1aaad5efa847339a48871ae889bf9a" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Create" />
                            <tagged-value id="tv244c1bcb50b84a98b8d2ba6e7c81ef44" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Characters\EnemyCatalog.cs" />
                            <tagged-value id="tvebbf3865b0e84f8482ef793f3a602964" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvb7e655375b5340f6b35365141ec617ab" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="2391" />
                            <tagged-value id="tv63366ff87fd44374a5eb8fd9625a5d8c" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="730" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        (int health, int armorClass, int gold, int damageDie) = enemy.Tier switch
        {
            "uncommon" =&gt; (14, 11, 12, 6),
            "elite" =&gt; (20, 12, 20, 8),
            "rare" =&gt; (26, 13, 30, 10),
            _ =&gt; (10, 10, 8, 6)
        };
        CharacterClass characterClass = ClassCatalog.Find(enemy.ClassId ?? "fighter");
        string visualAssetId = $"enemy.{enemy.Biome.ToString().ToLowerInvariant()}.{enemy.Id}";
        return new BiomeEnemyNpc(enemy.Name, visualAssetId, health, armorClass, characterClass, gold, enemy.Biome)
        {
            Weapon = new Weapon("natural-attack", "Doğal Saldırı", 0, 0, damageDie)
        };
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
