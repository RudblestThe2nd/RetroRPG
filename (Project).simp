                          <source-codes>
                            <source-code language="CSharp">
        int remaining = Math.Max(0, Health - Math.Max(0, amount));
                                                                                   
        if (remaining == 0 &amp;&amp; Health &gt; 0 &amp;&amp;
            Equipment.Get(EquipmentSlot.StoryLayer) is FatebreakerArmor armor &amp;&amp; armor.TryUseLastStand())
            remaining = 1;
        Health = remaining;
    </source-code>
                          </source-codes>
                        </operation>
