                            <source-code language="CSharp">
        if (map.Get(coordinate) is not HexTile gate) return;
        gate.IsLocked = true;
        gate.IsPermanentObstacle = false;
        gate.IsDangerous = false;
        gate.IsForcedCombat = false;
        gate.LockReason = reason;
    </source-code>
