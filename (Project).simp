                        <tagged-value id="tvb2a47390775549c5a548fc682c5ed245" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="11/03/2026 08:51:06" />
                      </tagged-values>
                      <documentations>
                        <doc id="bef19e2bd8614ab28af34098728afc7c">
                          <text>
                            <default>
                              <style font-name="Verdana" font-size="12">
                                <text>
                                  <solid-brush color="#FF000000" />
                                </text>
                              </style>
                            </default>
                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> d20 + nitelik kontrolü. Başarısızlık hikâyeyi kilitlemez; yalnız bedel veya alternatif yol üretir.
</t>
                                </p>
                              </paragraph>
                            </content>
                          </text>
                        </doc>
                      </documentations>
                      <owned-items />
                      <attributes>
                        <attribute id="a71b604f2c60f49e5a71d208e4e126eaf51" cid="PROP129" name="id" creation-date="11/04/2026 08:41:07" property-ref="36cf1a26420d4ff1b1b1429ed9b391c3" />
                        <attribute id="a555b36d6fa964ed989746770ba28ec7551" cid="PROP130" name="title" creation-date="11/04/2026 08:41:07" property-ref="d7a62fd0a1274b1eab434d293e5344d2" />
                        <attribute id="a1211fe982fa1401b8c55e826615ae0a751" cid="PROP131" name="scene" creation-date="11/04/2026 08:41:07" property-ref="1dfcb895be7b49af802b1130ea5d92f2" />
                        <attribute id="a6f7776001a7d4357b6cebb3deca93ab951" cid="PROP132" name="pages" creation-date="11/04/2026 08:41:07" property-ref="e95c77213d224d6fb1c396dac4d5365e" />
                        <attribute id="acf22c0b6b5c64a0e8c2b884281f9d0b051" cid="PROP133" name="choices" creation-date="11/04/2026 08:41:07" property-ref="8c60eff75fe44975a501fa6a41991d8b" />
                        <attribute id="a8e28e6682669425ba2e444db6c5950da52" cid="PROP134" name="Choices" creation-date="11/04/2026 08:41:07" property-ref="652b60f98b364849abeea361f50dd433" />
                      </attributes>
                      <operations>
                        <operation id="o4854282b2fe34991acf765311d50278f52" cid="OP018" name="CheckBonus" creation-date="11/04/2026 08:41:07" type="int" type-id="CSharp.int" visibility="public" static="true">
                          <parameters>
                            <parameter id="p8712c63bd9eb4ea6bd272bb7d9abcc52" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p86d72e9db3db453bb46fecb9e6e4d008" name="check" type="StoryCheck" type-id="StoryCheck" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv5271f7c3c7e54640ae9ebeab39734977" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="CheckBonus" />
                            <tagged-value id="tv3246a22e32864711ae1b4f3d85093faa" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryEvent.cs" />
                            <tagged-value id="tv26e621e034c04cf6b113e83173d07da6" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvbfb0858869c54a2c8b91f669f5221f49" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="6680" />
                            <tagged-value id="tva3cc6afed26841d2af22dab3565c37db" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="366" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        int bonus = WorldEncounter.CheckBonus(session.Player, check.Stat);
        if (check.AlternateStat is BackgroundStat alternate)
            bonus = Math.Max(bonus, WorldEncounter.CheckBonus(session.Player, alternate));
        return bonus + (check.Bonus?.Invoke(session) ?? 0);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="oc37e26749d564a34897775ca4236801a52" cid="OP019" name="Resolve" creation-date="11/04/2026 08:41:07" type="StoryOutcome" type-id="Class:a97b1b9d203b4dfabdb10cc8df7ef393" visibility="public">
                          <parameters>
                            <parameter id="p9daf86626a544c1c98852f11f051cc81" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p03bcf63ff96a47a9b2535c6906dc6e80" name="choice" type="StoryChoice" type-id="StoryChoice" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p53f55197753746019b3e1393389ad9c9" name="roll" type="D20Roll" type-id="D20Roll" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv4838fafe99f745f4a851939ad539571c" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Resolve" />
                            <tagged-value id="tvcd8917afa2994ecea4425e8aff30a47e" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryEvent.cs" />
                            <tagged-value id="tve4f2aac321d14cdebae1229e39100842" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv4efc23f24c814b7dbd6368b9c5b53ecc" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="7200" />
                            <tagged-value id="tvcea20a399af74bb6abb922a0d0e250af" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="561" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        if (choice.Check is not StoryCheck check) return Apply(session, true, choice.SuccessText, choice.Success, null);
        if (roll is null) throw new InvalidOperationException("Bu seçim d20 kontrolü gerektirir.");
        bool success = Succeeds(roll, check.Difficulty);
        return success
            ? Apply(session, true, choice.SuccessText, choice.Success, roll)
            : Apply(session, false, choice.FailureText, choice.Failure, roll);
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
                    <item id="c1cb35afaa574748b1753bf8187380a5" cid="PROP068" type="property" name="PrisonerRescued" owner="8137290d893a4716ac5dcb48d020cf91" creation-date="11/04/2026 08:41:07" visibility="public">
