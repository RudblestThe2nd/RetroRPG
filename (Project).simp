                      <operations>
                        <operation id="o9e8ecba5a18b4975a7e675919755d2bb62" cid="OP038" name="Register" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="public">
                          <parameters>
                            <parameter id="p1b1c54d0ae8c48a3bca237f8986cc7a0" name="id" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pab6facdfa14e4b7d913409545325cef9" name="relativePath" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv6a4fc51f473248f28eb4e3feeeae6b01" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Register" />
                            <tagged-value id="tvde07d97d89fc43ea872fda12d5c36e4c" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Assets\AssetCatalog.cs" />
                            <tagged-value id="tv044c29ed36a8435e94fc9819f906720a" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv6dfad622032a4323a82ffe6d4f85660c" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="384" />
                            <tagged-value id="tv540f03216385463183cfa2d666420af6" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="352" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string fullPath = Path.GetFullPath(Path.Combine(AssetRoot, relativePath));
        if (!fullPath.StartsWith(AssetRoot, StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException("Asset yolu proje kökünün dışına çıkamaz.");
        _paths[id] = fullPath;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o5356090f6a8b46718001fc739ce0146463" cid="OP039" name="Resolve" creation-date="11/04/2026 08:41:07" type="string" type-id="CSharp.string" visibility="public">
                          <parameters>
                            <parameter id="p0a7059b1f75b4411a1579a1d3453fd92" name="id" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv328787369dd14428ad438e459062148b" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Resolve" />
                            <tagged-value id="tvec04bf66f84447d99e72f8c8c186a9af" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Assets\AssetCatalog.cs" />
                            <tagged-value id="tv0db3b40f107d4d408c7fffff4bed1e66" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvb3b079a8fc334406bcf64c2028f0b0e4" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="742" />
                            <tagged-value id="tv24978ddf2dc8440095f475593185718a" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="282" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        if (!_paths.TryGetValue(id, out string? path)) throw new KeyNotFoundException($"Asset bulunamadı: {id}");
        if (!File.Exists(path)) throw new FileNotFoundException($"Asset dosyası kayıp: {path}", path);
        return path;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o77015e93f8854bb6b118ddcce957e76863" cid="OP040" name="TryResolve" creation-date="11/04/2026 08:41:07" type="bool" type-id="CSharp.bool" visibility="public">
                          <parameters>
                            <parameter id="p8aced5c431e44ba8a85e6aff9d5274d7" name="id" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pa8bc2c7576194fb9bd2edeaaa661f7a5" name="path" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" direction="Out" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvb921086606984c4aba56553142425866" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="TryResolve" />
                            <tagged-value id="tv0a811e18737a476c8ebeb653ae45bfcb" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Assets\AssetCatalog.cs" />
                            <tagged-value id="tve3e4e96d75f3459d832bcab4e240ab53" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvd873929e928f4e5da9894b8bd63b6de6" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1030" />
                            <tagged-value id="tv64795e104baa41e68e20547aefc91629" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="239" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        path = string.Empty;
        if (!_paths.TryGetValue(id, out string? candidate) || !File.Exists(candidate)) return false;
        path = candidate;
        return true;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o320ce6b4439a413d851454ec6b583ae363" cid="OP041" name="LoadJson" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="public">
                          <parameters>
                            <parameter id="p164e1532943b4a46b694e8de3b2a9e50" name="manifestPath" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv8a2b87824a8b4833927fe80e11c27c69" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="LoadJson" />
                            <tagged-value id="tvba81897859534413a37c73d71c1f3763" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Assets\AssetCatalog.cs" />
                            <tagged-value id="tv66a649dde9cc4cb5bc40f2473ff30881" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tve0dbe8b5baad495e9b14dcb873800033" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1275" />
                            <tagged-value id="tv3878e308fd7e4c479bb7727cba9d5886" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="398" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string json = File.ReadAllText(manifestPath);
        AssetManifest? manifest = JsonSerializer.Deserialize&lt;AssetManifest&gt;(json, JsonOptions.Default);
        if (manifest is null) throw new InvalidDataException($"Manifest okunamadı: {manifestPath}");
        foreach (AssetEntry entry in manifest.Assets) Register(entry.Id, entry.Path);
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
