                      <operations>
                        <operation id="o52154148d42549bb988e6d1de79268a7142" cid="OP115" name="RollInitiative" creation-date="11/04/2026 08:41:07" type="InitiativeRoll" type-id="InitiativeRoll" visibility="public">
                          <parameters>
                            <parameter id="p4ef991fe92ea48f591464e65a410e671" name="combatant" type="ICombatant" type-id="ICombatant" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv4c8263e896024d07b1e277b1c103e571" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="RollInitiative" />
                            <tagged-value id="tv8472b71006314ec19b75853084801c6d" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Combat\CombatService.cs" />
                            <tagged-value id="tv22088577884c42c58dd9a7608c89a80b" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvc35010d081374241aa55351f59c2a4c7" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="344" />
                            <tagged-value id="tvf5d5708adacd4722a44691142455cfd2" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="199" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        var result = _dice.RollD20(combatant.InitiativeBonus);
        return new InitiativeRoll(result.RawValue, result.Bonus);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o4174bec92f34440ab98b6b4d50d52f41143" cid="OP116" name="Attack" creation-date="11/04/2026 08:41:07" type="AttackRoll" type-id="AttackRoll" visibility="public">
                          <parameters>
                            <parameter id="p7ef5a1e9592d41f5913be58d69ca8aa9" name="attacker" type="ICombatant" type-id="ICombatant" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pd3f5bc70d9b04929b6cd5c3750dd8502" name="defender" type="ICombatant" type-id="ICombatant" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p04779c44374646a397c7ba3cd622bf3d" name="attackAdjustment" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p835731c123134d629c1a0bc651659885" name="damageDie" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p5eadf8d5a2d34eada0cd805ce683244d" name="damageBonusAdjustment" type="int" type-id="CSharp.int" default-value="0" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tva842920f69304b4b9469b9b7d5a98954" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Attack" />
                            <tagged-value id="tv1c1216a90ceb4f9cbc464bb7f5d5c10a" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Combat\CombatService.cs" />
                            <tagged-value id="tv440d8d8661fb4c3fbfeaf56e34f0976e" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv972777cd223e426b98ad9adf1b121aca" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="686" />
                            <tagged-value id="tv75f93351347347d399e7f9c06d33898d" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="950" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        var raw = _dice.RollD20(attacker.AttackBonus + attackAdjustment);
        var attack = new AttackRoll(raw.RawValue, raw.Bonus, defender.ArmorClass);
        _log.Add(new CombatLogEntry(
            $"{attacker.Name}: d20 {attack.RawValue} + {attack.Bonus} = {attack.Total} / AC {attack.TargetArmorClass}",
            attack.RawValue, attack.Bonus, attack.TargetArmorClass, attack.IsHit));

        if (attack.IsHit)
        {
            DamageResult damage = new(_dice.Roll(Math.Max(2, damageDie)),
                Math.Max(0, attacker.DamageBonus + damageBonusAdjustment), attack.IsCritical);
            defender.ReceiveDamage(damage.Total);
            _log.Add(new CombatLogEntry($"Hasar: {damage.Total}", damage.DieValue, damage.Bonus, 0, true));
        }

        return attack;
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
