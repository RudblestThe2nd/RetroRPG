                        <attribute id="abffb97d2159c44938590f1a13310d13878" cid="PROP261" name="Weapon" creation-date="11/04/2026 08:41:07" property-ref="2383d04d6f8e4e3fbc8112465dd2c4e9" />
                        <attribute id="afcd058a482a84fa6bb9e2215c21cc5e679" cid="PROP262" name="ExtraItems" creation-date="11/04/2026 08:41:07" property-ref="a26deb2f4bcc48fc8af593cf2b9537bf" />
                      </attributes>
                      <operations>
                        <operation id="oee2c95896ad14608a6b100ba10b2bf1f79" cid="OP055" name="GiveTo" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="public">
                          <parameters>
                            <parameter id="pa10d2342f0cc44098ccae63bc9acd950" name="player" type="PlayerCharacter" type-id="PlayerCharacter" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tve9b1713b97044f6aa2e32cd5a069b19d" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="GiveTo" />
                            <tagged-value id="tv597b1cab4b5d4edea435674d65fb2128" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Items\ItemCatalog.cs" />
                            <tagged-value id="tv16f76db521d641c7ae47b08ace9fb5a0" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvbea8f388d27b45f993d05fdcd56f7ea1" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1712" />
                            <tagged-value id="tvc8dd4f70d5434e80a7ab1c1c214903c4" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="387" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        player.Inventory.Add(Weapon);
        player.Equipment.Equip(Weapon, Weapon.Slot);
        foreach (Item item in ExtraItems)
        {
            player.Inventory.Add(item);
            if (item is Armor armor &amp;&amp; player.Equipment.Get(armor.Slot) is null)
                player.Equipment.Equip(armor, armor.Slot);
        }
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
