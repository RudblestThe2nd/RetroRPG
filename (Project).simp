                        <tagged-value id="tv219f4723a64740e483435b711c70e059" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="3265" />
                        <tagged-value id="tve6f5e13d4daa4bf785e6c8b16f54e686" name="SourceCodeFileSize" type="text" multiple="false" hidden="true" value="3682" />
                        <tagged-value id="tvfa7a91ce8c294303abb6878ca486c663" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="11/01/2026 14:27:53" />
                      </tagged-values>
                      <documentations>
                        <doc id="08c838d3dfa444bb8f7713e55f2648e8">
                          <text>
                            <default>
                              <style font-name="Verdana" font-size="12">
                                <text>
                                  <solid-brush color="#FF000000" />
                                </text>
                              </style>
                            </default>
                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> İki hikâye manifestini okur. Ana hikâye manifesti "directory", final boss manifesti "folder" alanını kullanır.
</t>
                                </p>
                              </paragraph>
                            </content>
                          </text>
                        </doc>
                      </documentations>
                      <owned-items />
                      <attributes>
                        <attribute id="acbebd9d2ead94da8a70b5794e0e02e7d111" cid="PROP365" name="MainStoryManifest" creation-date="11/04/2026 08:41:07" property-ref="ce6cc68dfc2d4076818639780e4e5e31" />
                        <attribute id="a9ce0be452bd14f52a34b432e2f61de58111" cid="PROP366" name="FinalBossManifest" creation-date="11/04/2026 08:41:07" property-ref="43cc13437aa649ce8b76e883e4b564ff" />
                        <attribute id="a9bd75aca91b74c9eac4dedf21c85d498112" cid="PROP367" name="DefaultFps" creation-date="11/04/2026 08:41:07" property-ref="058f2bf32eaf4620b1b9ebcef08fafc5" />
                        <attribute id="ac176d81d520f4b079e9a64f5f2d0d220112" cid="PROP368" name="_sequences" creation-date="11/04/2026 08:41:07" property-ref="bf88453ff27e4a168452303759b92d4f" />
                        <attribute id="a1c6f2bee6dc347f4a87adf1dd59d8ed8112" cid="PROP369" name="Sequences" creation-date="11/04/2026 08:41:07" property-ref="b0a8c6bd94f04fd88caadff54c23ee47" />
                      </attributes>
                      <operations>
                        <operation id="o500a75b1eec64eed9854f6ffadf38b86112" cid="OP082" name="Load" creation-date="11/04/2026 08:41:07" type="CinematicLibrary" type-id="Class:d13ffc60f6704548bb08961e340c786c" visibility="public" static="true">
                          <parameters>
                            <parameter id="p2a0cba5075b0401fbc52ccf70c30f6f7" name="gameDesignRoot" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv8517c85a56404696a1db0e5e7536a72b" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Load" />
                            <tagged-value id="tv446436bae389451c83238e519741956f" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\CinematicLibrary.cs" />
                            <tagged-value id="tvc162b032f7254ffa82eab5da34a22d8d" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvb4cb690a067b44d586742c3df3b5e018" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="964" />
                            <tagged-value id="tv6625ad187563401a9a10c412715952e6" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1492" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        var sequences = new Dictionary&lt;string, CinematicSequence&gt;(StringComparer.OrdinalIgnoreCase);
        foreach (string manifest in new[] { MainStoryManifest, FinalBossManifest })
        {
            string manifestFolder = manifest[..manifest.LastIndexOf('/')];
            using JsonDocument document = JsonDocument.Parse(File.ReadAllText(Path.Combine(gameDesignRoot, manifest)));
            foreach (JsonElement sequence in document.RootElement.GetProperty("sequences").EnumerateArray())
            {
                string id = sequence.GetProperty("id").GetString()!;
                string folder = (sequence.TryGetProperty("directory", out JsonElement directory) ? directory : sequence.GetProperty("folder")).GetString()!;
                string[] frames = sequence.GetProperty("frames").EnumerateArray()
                    .Select(x =&gt; $"{manifestFolder}/{folder}/{x.GetString()}").ToArray();
                int fps = sequence.TryGetProperty("fps", out JsonElement fpsValue) ? fpsValue.GetInt32() : DefaultFps;
                string[] meanings = sequence.TryGetProperty("frameMeanings", out JsonElement meaningValues)
                    ? meaningValues.EnumerateArray().Select(x =&gt; x.GetString()!).ToArray()
                    : [];
                sequences[id] = new CinematicSequence(id, frames, Math.Max(1, fps), meanings);
            }
        }
        return new CinematicLibrary(sequences);
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
