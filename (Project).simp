                      <owned-items />
                      <attributes>
                        <attribute id="af143321252e9402ebf428c89c617393056" cid="PROP145" name="create" creation-date="11/04/2026 08:41:07" property-ref="53fc92d898ae4feab97fc39d355ef73a" />
                        <attribute id="ad4a8651a2ff64157addf8c7df3b0a8ca56" cid="PROP146" name="replacesQuestKey" creation-date="11/04/2026 08:41:07" property-ref="56e7efa8282848a0be92d93e2459620a" />
                        <attribute id="a7f679785fba44c20a00960694b50f2e256" cid="PROP147" name="equip" creation-date="11/04/2026 08:41:07" property-ref="15a6c21b1a0645ebb37a724631f9a6bc" />
                        <attribute id="a70fea99dafb840278dfcf64613b61a0656" cid="PROP148" name="Summary" creation-date="11/04/2026 08:41:07" property-ref="e85264212bb44c9b8c36565693db17a5" />
                      </attributes>
                      <operations>
                        <operation id="oea1bd05736024a2da7d3971b7f89b79456" cid="OP027" name="Apply" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="public">
                          <parameters>
                            <parameter id="p2927642b68294dd2b6e156adb5576167" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv86b6663108e0429283247361f850fc27" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Apply" />
                            <tagged-value id="tvfb99e2bdd80743d1b78aeade9d0a3127" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryConsequence.cs" />
                            <tagged-value id="tv7ff19f3372fe4b399ff791159b00d390" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvea6b1c277d914185b85d6e82ec942825" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1023" />
                            <tagged-value id="tv7ce46dd3f4be4b50b5a5b9238b9481b0" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="797" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        PlayerCharacter player = session.Player;
        if (replacesQuestKey is not null)
            foreach (QuestItem old in player.Inventory.Items.OfType&lt;QuestItem&gt;().Where(x =&gt; x.QuestKey == replacesQuestKey).ToArray())
                player.Inventory.Remove(old);

        Item item = create();
        bool duplicate = item switch
        {
            QuestItem quest =&gt; player.Inventory.Items.OfType&lt;QuestItem&gt;().Any(x =&gt; x.QuestKey == quest.QuestKey),
            FatebreakerArmor =&gt; player.Inventory.Find&lt;FatebreakerArmor&gt;() is not null,
            _ =&gt; false
        };
        if (duplicate) return;

        player.Inventory.Add(item);
        if (equip &amp;&amp; item is Armor armor) player.Equipment.Equip(armor, armor.Slot);
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
