                      </stereotypes>
                      <tagged-values>
                        <tagged-value id="tv7b8bd6f29eb643dfa1eed6eaff134bdc" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Summary" />
                        <tagged-value id="tv472d1d9a506045c89fc9035d5b2272a7" name="SourceCodeGroup" type="reference" multiple="false" hidden="true" ref="p01c8fc639e804c89b9a7f7714c943401_493370883" />
                        <tagged-value id="tvd048a69146f74028ac2486db5201ba3a" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\World\EncounterChoice.cs" />
                        <tagged-value id="tv115e6ed198c84f779930aa0a1b9e6ac3" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                        <tagged-value id="tv676791263f454fe4b1755e6b232df26e" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="365" />
                        <tagged-value id="tvbe139c32ffdf4bd7a05bd989f6f65257" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="14840" />
                        <tagged-value id="tv8394447db64b43888b24dd50629f49a1" name="SourceCodeFileSize" type="text" multiple="false" hidden="true" value="15766" />
                        <tagged-value id="tv2773ad837a2d44b4a09428cf27d660a3" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="11/03/2026 08:51:06" />
                      </tagged-values>
                      <stereotype-instances>
                        <stereotype id="f707f079cb8a466c9da83d4673843c92_property_c" type="property" creation-date="11/04/2026 08:41:07" ref="" />
                      </stereotype-instances>
                      <structural-feature type="string" type-id="CSharp.string" />
                      <property>
                        <source-codes>
                          <source-code language="CSharp" uid="scs-e301d914-4bcc-4017-ba46-860c3706ad6a">
                            <script name="Get">
            var parts = new List&lt;string&gt; { Text };
            if (GoldDelta &gt; 0) parts.Add($"+{GoldDelta} altın");
            if (GoldDelta &lt; 0) parts.Add($"{GoldDelta} altın");
            if (HealthDelta &gt; 0) parts.Add($"+{HealthDelta} CAN");
            if (HealthDelta &lt; 0) parts.Add($"{HealthDelta} CAN");
            if (AddPotion) parts.Add("+1 iyileştirme iksiri");
            if (Stat is BackgroundStat stat &amp;&amp; StatDelta != 0)
                parts.Add($"{EncounterReport.StatName(stat)} {(StatDelta &gt; 0 ? "+" : "")</script>
                          </source-code>
                        </source-codes>
