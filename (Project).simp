                          <documentations>
                            <doc id="792af0200fb54dc098da3e66eb89576b">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Hikâye geçişleri oyuncuyu yürütmeden taşır: prolog sonrası Yeşilgeçit, düşüş sonrası kulenin dibi.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (Map.Get(coordinate) is null) return;
        CurrentHex = coordinate;
        Map.RevealAround(CurrentHex);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="of2ed8276e81a44ae981f287d59640a48155" cid="OP136" name="TryMove" creation-date="11/04/2026 08:41:07" type="bool" type-id="CSharp.bool" visibility="public">
                          <parameters>
                            <parameter id="pbc7682e0b9be4f58b056de697df1de5c" name="target" type="HexCoordinate" type-id="HexCoordinate" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tva1609793b15f4a88ad50174593075e92" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="TryMove" />
                            <tagged-value id="tv0f79035b0f79442db675f9820c079ca9" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Game\GameSession.cs" />
                            <tagged-value id="tvb11ba3f2302a4231ab6eac3ff8d7a433" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvffa22c32c97b437e84e9dd7530253510" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="894" />
                            <tagged-value id="tv80f7dcd74c2b4fe4ae4f99fe21e865f3" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="201" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        if (!Map.CanMove(CurrentHex, target)) return false;
        CurrentHex = target;
        Map.RevealAround(CurrentHex);
        return true;
    </source-code>
                          </source-codes>
                        </operation>
