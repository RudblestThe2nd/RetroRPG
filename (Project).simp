                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> 0 prolog, 1 Silinen Kervan, 2 Üç Yol Taşı, 3 mor bölge, 4 Göz Kulesi, 5 final.
</t>
                                </p>
                              </paragraph>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Görev durumlarından hesaplanır; böylece bölüm bilgisi görevlerle hiçbir zaman çelişmez.
</t>
                                </p>
                              </paragraph>
