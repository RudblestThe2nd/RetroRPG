                        <operation id="o7bbaa869fe224cf8b2d89611d15f645c35" cid="OP004" name="RevealAround" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="public">
                          <parameters>
                            <parameter id="p069a09de6e64426785701e2c36d1144c" name="center" type="HexCoordinate" type-id="HexCoordinate" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
