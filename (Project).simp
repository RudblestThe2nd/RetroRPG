                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Rota adımında çağrılır. Pass olayları her geçişte, Arrive olayları yalnız rota orada bitince oynar.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (!UsesMainStory(session)) return null;
        return Matching(session, StoryTriggerKind.Pass, hex, null)
               ?? (routeEnd ? Matching(session, StoryTriggerKind.Arrive, hex, null) : null)
               ?? Resumable(session, hex);
    </source-code>
                          </source-codes>
                        </operation>
