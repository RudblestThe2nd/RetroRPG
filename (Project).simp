                      </attributes>
                      <operations>
                        <operation id="o0f4b3e6ac96944ca827e551aa80e1fb0135" cid="OP112" name="Pick" creation-date="11/04/2026 08:41:07" type="WorldEncounter" type-id="Class:97124e1024e04b74a7d69e4f98c89fb5" visibility="public" static="true">
                          <parameters>
                            <parameter id="pb5706e65f78446f5ba13fc02edd9e51d" name="biome" type="Biome" type-id="Biome" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p0b796b65124844d59139a62903b302db" name="seed" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv18b825c250ec4ee58664fd6c416748c2" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Pick" />
                            <tagged-value id="tv1bba23cfbe944854a809d064076a6563" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\World\WorldEncounter.cs" />
                            <tagged-value id="tv079e751ee5a74f12a81592cbbb2e41b7" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv9e5876962e5341b99008e1f2783b5180" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="11939" />
                            <tagged-value id="tv168872af9fb04529b9f707a1c52867d9" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="289" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        WorldEncounter[] matches = All.Where(x =&gt; x.Biome == biome).ToArray();
        if (matches.Length == 0) matches = All.ToArray();
        return matches[Math.Abs(seed == int.MinValue ? 0 : seed) % matches.Length];
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
