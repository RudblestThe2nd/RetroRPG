                        <operation id="o83fddfbeb5234d7e982cf41d55992cf835" cid="OP011" name="MarkPermanentObstacle" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="private" static="true">
                          <parameters>
                            <parameter id="pab2d3d8e14984476897bcb6f6bf96338" name="tile" type="HexTile" type-id="HexTile" creation-date="11/04/2026 08:41:07" />
