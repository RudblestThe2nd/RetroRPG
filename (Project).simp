                      </tagged-values>
                      <documentations>
                        <doc id="9cd333a928e04c05bd06e9cac0aa2ef1">
                          <text>
                            <default>
                              <style font-name="Verdana" font-size="12">
                                <text>
                                  <solid-brush color="#FF000000" />
                                </text>
                              </style>
                            </default>
                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Envanterdeki eşyaları kayda yazar ve geri kurar. Takılı eşyalar Equipped ile işaretlenir.
</t>
                                </p>
                              </paragraph>
                            </content>
                          </text>
                        </doc>
                      </documentations>
                      <stereotype-instances>
                        <stereotype id="e5fbf9cfcef5433f8748a2cb921fa92b_static_c" type="static" creation-date="11/04/2026 08:41:07" ref="" />
                      </stereotype-instances>
                      <operations>
                        <operation id="o51da30f5062b49e79ccbfa5da8b5345f74" cid="OP049" name="ToSaveData" creation-date="11/04/2026 08:41:07" type="ItemSaveData" type-id="Class:7e6d0ecccc0a4cf4879d9f4939b47be8" visibility="public" static="true">
                          <parameters>
                            <parameter id="p25044fb425564dee98c65ced4829467a" name="inventory" type="Inventory" type-id="Inventory" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pc9c690a05ab0417d82a7c38447a3a427" name="equipment" type="EquipmentSet" type-id="EquipmentSet" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvac2f774c430449009df7a92b1e42975b" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="ToSaveData" />
                            <tagged-value id="tv45da7f5ff6f0456c9e2ebca5311d7bac" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Persistence\ItemSaveMapper.cs" />
                            <tagged-value id="tvfdc32b4e1d774ebbb14d98438cc24649" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvcbbe82bad2ea48538381315960a334eb" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="228" />
                            <tagged-value id="tved9f87306ff6496f90809023cec442c8" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="358" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        HashSet&lt;Item&gt; equipped = equipment.Equipped.Values.ToHashSet();
        IEnumerable&lt;Item&gt; items = inventory.Items.Concat(equipped.Where(x =&gt; !inventory.Items.Contains(x)));
        return items.Select(x =&gt; ToSaveData(x, equipped.Contains(x))).ToArray();
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="oe1f1ae037171471c954c37e67aa0861e74" cid="OP050" name="Restore" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="public" static="true">
                          <parameters>
                            <parameter id="p316d79a027104a0087430124a1b18d4e" name="items" type="IEnumerable&lt;ItemSaveData&gt;" type-id="CSharp.IEnumerable_ItemSaveData" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p5e44bdf621734e20a1e15b20b0b9da92" name="inventory" type="Inventory" type-id="Inventory" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pf68d93035b704a5db341b4de237303b6" name="equipment" type="EquipmentSet" type-id="EquipmentSet" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvd627123bc87e4a988e665491995738a8" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Restore" />
                            <tagged-value id="tvd746441ed2c040b0b801524bd96ecaeb" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Persistence\ItemSaveMapper.cs" />
                            <tagged-value id="tv9205ff16123347f8b297d0639264af84" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv6161d30fab634cd7841c757a52a93c73" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="592" />
                            <tagged-value id="tvde6836cbf1f645d1962094a86829e7c6" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="353" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        foreach (ItemSaveData data in items)
        {
            Item item = FromSaveData(data);
            inventory.Add(item);
            if (data.Equipped &amp;&amp; data.Slot is EquipmentSlot slot) equipment.Equip(item, slot);
        }
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
