                        <operation id="o61dc3dc732a645ff8516bb1c661904e654" cid="OP023" name="Finish" creation-date="11/04/2026 08:41:07" type="StoryEvent" type-id="Class:5c4befe974a24e87b184394b91e318e1" visibility="public" static="true">
