                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        var options = new JsonSerializerOptions(JsonOptions.Default) { Converters = { new JsonStringEnumConverter() } };
        EnemyDefinitionDocument document = JsonSerializer.Deserialize&lt;EnemyDefinitionDocument&gt;(File.ReadAllText(path), options)
            ?? throw new InvalidDataException($"Düşman tanımları okunamadı: {path}");
        return new EnemyCatalog(document);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o64866894de274dcd9d7b977d4f12c963121" cid="OP088" name="PickEncounter" creation-date="11/04/2026 08:41:07" type="EnemyDefinition" type-id="Class:ce443f0f35f448aa82f9d1d081cf95db" visibility="public">
                          <parameters>
                            <parameter id="p0836cdeb8366430db69f1f9b1e83308d" name="biome" type="Biome" type-id="Biome" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p3b3a4e2185f242a2ab5ab28256989624" name="distanceFromStart" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pa81e5e06631446779b0b652b7e41ac9c" name="seed" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvc08984fca66a4c22a0ef7a37fd2985de" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="PickEncounter" />
                            <tagged-value id="tvf97c816c61d4472682eb82bd6966efaf" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Characters\EnemyCatalog.cs" />
                            <tagged-value id="tv3cc565bf3c7b4b35a1d82e1a334547ee" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv3acbbc72cbee42d1bed2069ea38594aa" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1352" />
                            <tagged-value id="tv0018493e182a4ed9b4da07aad542441b" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="550" />
                          </tagged-values>
                          <documentations>
                            <doc id="7e790a8a030546b8a7fc4db7ddf07b21">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Merkezden uzaklaştıkça daha güçlü düşman çıkar. Aynı hex her zaman aynı düşmanı verir.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        string[] tiers = distanceFromStart switch
        {
            &lt;= 2 =&gt; ["common"],
            3 =&gt; ["common", "uncommon"],
            _ =&gt; ["uncommon", "elite"]
        };
        EnemyDefinition[] pool = _document.Enemies.Where(x =&gt; x.Biome == biome &amp;&amp; tiers.Contains(x.Tier)).ToArray();
        if (pool.Length == 0) throw new KeyNotFoundException($"{biome} biyomu için düşman tanımı yok.");
        return pool[Math.Abs(seed) % pool.Length];
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o6343948964d04b6a9520beabe6e89445121" cid="OP089" name="SpritePath" creation-date="11/04/2026 08:41:07" type="string" type-id="CSharp.string" visibility="public">
