                      <documentations>
                        <doc id="90e91302c6964689abb4a830526f893c">
                          <text>
                            <default>
                              <style font-name="Verdana" font-size="12">
                                <text>
                                  <solid-brush color="#FF000000" />
                                </text>
                              </style>
                            </default>
                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Kaderbozan Zırhı: Kalpaklı Süvari'nin verdiği efsanevi hikâye zırhı.
</t>
                                </p>
                              </paragraph>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Göğüs yuvasını değil StoryLayer yuvasını kullanır; oyuncunun önceki göğüs zırhı yerinde kalır.
</t>
                                </p>
                              </paragraph>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Ham AC'si yalnız +1'dir. Asıl gücü Vaelor'un Kaderin Hükmü saldırısını kırmasıdır.
</t>
                                </p>
                              </paragraph>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Bütün ırk ve beden tipleri aynı katmanı kullanır; ırka göre kısıtlama yoktur.
</t>
                                </p>
                              </paragraph>
                            </content>
                          </text>
                        </doc>
                      </documentations>
