                      <operations>
                        <operation id="o8b2447fb0ec54fc885d8dee0fd0610ef94" cid="OP075" name="From" creation-date="11/04/2026 08:41:07" type="RememberedPerson" type-id="Class:da1bc84704e941d5888379a4b6ab2723" visibility="public" static="true">
                          <parameters>
                            <parameter id="p9386b47ebf9b40939f8d5d1b9c39b099" name="background" type="CharacterBackground" type-id="CharacterBackground" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv350b697838c04bf9a62292531daeab58" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="From" />
                            <tagged-value id="tv9d9356ab50994dc18a8ab107e6764052" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\RememberedPerson.cs" />
                            <tagged-value id="tv50fecb07243d4081a9100871cb7796af" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvbc77361c7787434f84a0b8bf25cfcd7d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="329" />
                            <tagged-value id="tv2cbffa0d3b9048f382e26ce0be84b028" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1202" />
                          </tagged-values>
                          <documentations>
                            <doc id="dee66c5da1624e6e8571c34f103955db">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Öncelik sırası hikâye planındaki sırayla aynıdır; ilk eşleşen bağ seçilir.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        HashSet&lt;string&gt; ids = background.Choices.Select(x =&gt; x.Id).Append(background.Id).ToHashSet();
        bool Has(params string[] options) =&gt; options.Any(ids.Contains);

        if (Has("turning-loss")) return new("lost-friend", "Arin", "çocukluk arkadaşın");
        if (Has("turning-oath", "goal-protect")) return new("sworn-ward", "Mira", "korumaya yemin ettiğin kişi");
        if (Has("family-soldiers", "profession-guard", "soldier-family"))
            return new("forgotten-commander", "Komutan Doruk", "unutulan birliğinin komutanı");
        if (Has("family-nobles", "noble-family")) return new("family-envoy", "Elçi Kaan", "ailenin elçisi olan kardeşin");
        if (Has("education-academy", "profession-scribe", "goal-knowledge", "temple-student"))
            return new("lost-mentor", "Usta Neva", "sana okumayı öğreten hocan");
        if (Has("family-merchants", "profession-trader", "childhood-caravan", "wandering-merchant"))
            return new("caravan-leader", "Kervanbaşı Tamer", "kayıp kervanın lideri");
        return new("lost-traveler", "Yolcu Ela", "doğduğun bölgeden kaybolan yolcu");
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
