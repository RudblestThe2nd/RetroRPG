                            <tagged-value id="tvf44e595f162f4d6ea7f8c7eab63e4d2d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1908" />
                            <tagged-value id="tvf23df1903b7c44bda40a8fc86ea65755" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="260" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string biome = enemy.Biome.ToString().ToLowerInvariant();
        return $"{_document.SpriteRoot}/{biome}/sprites/{enemy.Id}/{biome}-{enemy.Id}-{pose}-v{enemy.SpriteVersion}.png";
    </source-code>
                          </source-codes>
                        </operation>
