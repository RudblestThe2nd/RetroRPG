                      <operations>
                        <operation id="o7e9baa64710243b3b821acaaf2f02ff661" cid="OP037" name="Create" creation-date="11/04/2026 08:41:07" type="AssetCatalog" type-id="Class:95a1a871ec7f4950ab174810d56f1050" visibility="public" static="true">
                          <parameters>
                            <parameter id="p1f927815097d4d2685c81b25225f3341" name="gameDesignRoot" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv4ac61b818c03409fbcbe6b9aa37b1f7e" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Create" />
                            <tagged-value id="tv588d267e8b9749428914d3b21a6c7165" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Assets\DefaultAssetCatalog.cs" />
                            <tagged-value id="tv22a26121a0b24df5bfd3ea190655e237" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvb6e5704777074c068edf83ad3a502df7" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="79" />
                            <tagged-value id="tve4e0d8b9c3ee46cb846449ab916ebf40" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1009" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        var catalog = new AssetCatalog(gameDesignRoot);
        catalog.Register("map.world.2d", @"maps\hex\world-map-hex-2d-v1.png");
        catalog.Register("map.world.isometric", @"assets\final-production-v1\maps\world-map-hex-isometric-v1.png");
        catalog.Register("ui.combat.simple", @"assets\final-production-v2\ui\screens\runtime-800\combat-screen-simple-d20-v1.png");
        catalog.Register("dice.d20", @"assets\final-production-v2\combat\dice\runtime-256\d20-icon-v1.png");
        catalog.Register("manifest.production.v1", @"assets\final-production-v1\manifests\final-production-v1.json");
        catalog.Register("manifest.production.v2", @"assets\final-production-v2\manifests\final-production-v2.json");
        string projectManifest = Path.Combine(gameDesignRoot, "Content", "manifests", "asset-catalog-v1.json");
        if (File.Exists(projectManifest)) catalog.LoadJson(projectManifest);
        return catalog;
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
