                        <tagged-value id="tv9a1d1a14c58f439c91aad0a982a9dc44" name="SourceCodeGroup" type="reference" multiple="false" hidden="true" ref="p01c8fc639e804c89b9a7f7714c943401_493370883" />
                        <tagged-value id="tvac22200088b84692a07e5e08f9921ef2" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryDirector.cs" />
                        <tagged-value id="tva2623699b57b47bab926d89e27c80303" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                        <tagged-value id="tvdfff3e191b544dae8cd33897122cc2f9" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="349" />
                        <tagged-value id="tv8334c9559cc4425ba22060af048fbf95" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="5137" />
                        <tagged-value id="tv5d06761dc6824502bfb321cd3be6c36e" name="SourceCodeFileSize" type="text" multiple="false" hidden="true" value="5570" />
                        <tagged-value id="tv82f656f836ed47db88e89c96d5f371b5" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="11/01/2026 14:33:02" />
                      </tagged-values>
                      <documentations>
                        <doc id="43dda5d065e1486fa5aea45fbc8d9a61">
                          <text>
                            <default>
                              <style font-name="Verdana" font-size="12">
                                <text>
                                  <solid-brush color="#FF000000" />
                                </text>
                              </style>
                            </default>
                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Hangi olayın ne zaman oynayacağını seçer. Kurallar ekrandan bağımsızdır ve testlerde aynen kullanılır.
</t>
                                </p>
                              </paragraph>
                            </content>
                          </text>
                        </doc>
                      </documentations>
                      <stereotype-instances>
                        <stereotype id="d4cd5a79b33b4ae2bb989b4416c31ee7_static_c" type="static" creation-date="11/04/2026 08:41:07" ref="" />
                      </stereotype-instances>
                      <operations>
                        <operation id="obc5b8879941e42c2ab4fbb59940f8e4154" cid="OP020" name="ResumeEvent" creation-date="11/04/2026 08:41:07" type="StoryEvent" type-id="Class:5c4befe974a24e87b184394b91e318e1" visibility="public" static="true">
                          <parameters>
                            <parameter id="pa457cd3cf6454c4791255c3e5e982430" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvd995df779413499db4984b6748b428d9" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="ResumeEvent" />
                            <tagged-value id="tv0908ed7b620b4f8baeba4b52a7fbc790" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryDirector.cs" />
                            <tagged-value id="tve5e17d63b7b2497889fd7fea25dce478" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv7fd9b3e0887948ea900e316dab9d63a4" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="676" />
                            <tagged-value id="tv1749c0cddd0e47a2a79b25763832a49e" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="538" />
                          </tagged-values>
                          <documentations>
                            <doc id="79aaa038263640f688ba754a3b2f3cf2">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Yeni oyun, kayıt yükleme veya ölüm sonrası autosave: yarım kalan düğüm ya da prolog döner.
</t>
                                    </p>
                                  </paragraph>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Sürüm 1/2 kayıtlarında hikâye yoktur; bu durumda da prolog başlar.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (!UsesMainStory(session) || session.Story.IsFinished) return null;
        if (session.Story.Remembered is null) session.Story.Remember(RememberedPerson.From(session.Player.Background));

        if (session.Story.ActiveNodeId is string id &amp;&amp; StoryCatalog.Find(id) is StoryEvent active &amp;&amp; active.CanTrigger(session))
            return active;
        session.Story.ActiveNodeId = null;
        return Matching(session, StoryTriggerKind.Start, null, null);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="oae544a671c384da99afdbe8374ce72e454" cid="OP021" name="EventOnStep" creation-date="11/04/2026 08:41:07" type="StoryEvent" type-id="Class:5c4befe974a24e87b184394b91e318e1" visibility="public" static="true">
                          <parameters>
                            <parameter id="pd0ce26a62d914a82993a9ebae477c3ff" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p541eaea19b0144a0b3e04b1f024c0a0b" name="hex" type="HexCoordinate" type-id="HexCoordinate" creation-date="11/04/2026 08:41:07" />
