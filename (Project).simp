                            <tagged-value id="tv9e65d94e1f7547749986a2af9e13abda" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv755f979c71c5489dbad8661d6880611f" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1724" />
                            <tagged-value id="tv24a74225334f4b3e9d9101a777c1fb9e" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="575" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        Flags[flag] = "1";
        if (flag == "unlock:purple-gate")
        {
            Map.OpenPurpleGate();
            return;
        }
        HexCoordinate? coordinate = flag switch
        {
            "unlock:mountain-pass" =&gt; new HexCoordinate(3, -2),
            "unlock:cave-route" =&gt; new HexCoordinate(-6, 0),
            _ =&gt; null
        };
        if (coordinate is HexCoordinate hex &amp;&amp; Map.Get(hex) is HexTile tile)
        {
            tile.IsLocked = false;
            tile.LockReason = null;
        }
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
