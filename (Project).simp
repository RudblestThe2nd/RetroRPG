                          <parameters>
                            <parameter id="p7103d1e351bd412093418002b2da8610" name="path" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv86abf77db5494170a7680dc0266517d4" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Load" />
                            <tagged-value id="tv0cf72cc9b2e3423a988f694683baddd0" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Characters\EnemyCatalog.cs" />
                            <tagged-value id="tv6d77434d5a8640a2a7fd4ee894ebd49e" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
