                        <attribute id="aa418d74b96954da5becf37310cd6cce673" cid="PROP249" name="saveDirectory" creation-date="11/04/2026 08:41:07" property-ref="bb169f99381146e59564fdc62366d18d" />
                        <attribute id="a3e29c67d9dba467aaa045ef717095aa573" cid="PROP250" name="SaveDirectory" creation-date="11/04/2026 08:41:07" property-ref="1aea622aba4542b7a853e279a3ba94ba" />
                      </attributes>
                      <operations>
                        <operation id="o945d1b93e518417b9a9aa68ff2d8f5dc73" cid="OP046" name="Save" creation-date="11/04/2026 08:41:07" type="string" type-id="CSharp.string" visibility="public">
                          <parameters>
                            <parameter id="p993bc77c199f4001bd4d128a0bce76a3" name="data" type="GameSaveData" type-id="GameSaveData" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p9735ca283b084c56a98a5c961048568d" name="slot" type="string" type-id="CSharp.string" default-value="&quot;slot-1&quot;" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tva8cb2754a6fe4f0cb00c5fc2102f1566" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Save" />
                            <tagged-value id="tv924b3b1e5c2e465084466f39cc9497ef" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Persistence\SaveGameService.cs" />
                            <tagged-value id="tv0944f88e79f3422a97e9c374c3a864d6" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv17ddf497e48c443bb7bd6e8f0cf90a4d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="232" />
                            <tagged-value id="tv1d3f5de508c04a36b707aece7af34c7b" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="373" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        Directory.CreateDirectory(SaveDirectory);
        string path = Path.Combine(SaveDirectory, SafeSlot(slot) + ".json");
        PreserveOlderVersion(path, SafeSlot(slot), data.Version);
        File.WriteAllText(path, JsonSerializer.Serialize(data, JsonOptions.Default));
        return path;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o4d2184927c554caca5f0db5b71b7e6da73" cid="OP047" name="PreserveOlderVersion" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="private">
                          <parameters>
                            <parameter id="p22b9365a1c5c4024ae94a2d560940f98" name="path" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p1d4f9059856f436b835657d6f1fca146" name="slot" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pcb04dfacef06459c87990eca3b538c1f" name="newVersion" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv82e1ec540a2e499fa4d1dad0a476b1bd" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="PreserveOlderVersion" />
                            <tagged-value id="tveb68c3edfce041da99a0de427262ba90" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Persistence\SaveGameService.cs" />
                            <tagged-value id="tv804db7988fc24d39a6d1534981d7ea59" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv4283288f4503441ca59df20a41992ab3" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="717" />
                            <tagged-value id="tvb5ff8f765c6b410e9958f164b9e07036" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="610" />
                          </tagged-values>
                          <documentations>
                            <doc id="bb29ed95a1714aafb81945ae389312c9">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Eski sürüm kayıt dosyası üzerine yazılmadan önce bir kez yedeklenir; eski dosya hiç değiştirilmez.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (!File.Exists(path)) return;
        int oldVersion;
        try
        {
            using JsonDocument document = JsonDocument.Parse(File.ReadAllText(path));
            oldVersion = document.RootElement.TryGetProperty("Version", out JsonElement version) ? version.GetInt32() : 1;
        }
        catch (JsonException) { return; }
        string backup = Path.Combine(SaveDirectory, $"{slot}.v{oldVersion}-backup.json");
        if (oldVersion &lt; newVersion &amp;&amp; !File.Exists(backup)) File.Copy(path, backup);
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o41b8971be60a4dda8abba5c3759a9cf073" cid="OP048" name="Load" creation-date="11/04/2026 08:41:07" type="GameSaveData" type-id="Class:65c2fc5afc2b45cd80fcf98f9cb81175" visibility="public">
                          <parameters>
                            <parameter id="p44f0af32da1045b2acfd4f5f516ecfc0" name="slot" type="string" type-id="CSharp.string" default-value="&quot;slot-1&quot;" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tva4b194fa17404f23ae95b5887eeb6d21" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Load" />
                            <tagged-value id="tv64cbb168a28d49f68e77aa14746dc038" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Persistence\SaveGameService.cs" />
                            <tagged-value id="tv618a027f7ad2449a8231043aae7914d3" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv01e42f38654247dca77447f6ff42d307" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1333" />
                            <tagged-value id="tv723e5dba7452430d99c68e9e8d071ec6" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="405" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string path = Path.Combine(SaveDirectory, SafeSlot(slot) + ".json");
        if (!File.Exists(path)) throw new FileNotFoundException("Kayıt bulunamadı.", path);
        return JsonSerializer.Deserialize&lt;GameSaveData&gt;(File.ReadAllText(path), JsonOptions.Default)
            ?? throw new InvalidDataException("Kayıt dosyası okunamadı.");
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
