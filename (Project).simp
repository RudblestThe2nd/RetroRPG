                        <operation id="o3ef7ec672c6143c491f47bfbf43707aa35" cid="OP006" name="FindPath" creation-date="11/04/2026 08:41:07" type="IReadOnlyList&lt;HexCoordinate&gt;" type-id="IReadOnlyList&lt;HexCoordinate&gt;" visibility="public">
                          <parameters>
                            <parameter id="pa76345919546429ea344adf93cced71f" name="from" type="HexCoordinate" type-id="HexCoordinate" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p92ba8193b7f84c2493f9d5266e8b5d9e" name="to" type="HexCoordinate" type-id="HexCoordinate" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tva354b64c7957468caa7cca029b905ff6" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="FindPath" />
                            <tagged-value id="tvf54bc1357c0e4cb08ac7c54d71a6e8c9" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\World\HexMap.cs" />
                            <tagged-value id="tv1d01a8e455c04238a21c32c23efb4349" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv91e17b56416e42b7b3e8d751413d60bb" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1322" />
                            <tagged-value id="tveec2452a593d427dbb45698cb4905075" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1232" />
                          </tagged-values>
                          <documentations>
                            <doc id="de4172eeea6248858533e0461af03525">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Basit breadth-first search: kilitli hexlerden geçmeden en kısa yürüyüş rotasını döndürür.
</t>
                                    </p>
                                  </paragraph>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Sonuç başlangıç ve hedefi içerir; rota yoksa boş liste döner.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (!_tiles.ContainsKey(from) || !_tiles.TryGetValue(to, out HexTile? destination) || destination.IsLocked)
            return [];
        if (from == to) return [from];

        var frontier = new Queue&lt;HexCoordinate&gt;();
        var previous = new Dictionary&lt;HexCoordinate, HexCoordinate?&gt; { [from] = null };
        frontier.Enqueue(from);

        while (frontier.Count &gt; 0)
        {
            HexCoordinate current = frontier.Dequeue();
            foreach (HexCoordinate neighbor in current.Neighbors())
            {
                if (previous.ContainsKey(neighbor) || !_tiles.TryGetValue(neighbor, out HexTile? tile) || tile.IsLocked)
                    continue;
                previous[neighbor] = current;
                if (neighbor == to)
                {
                    var path = new List&lt;HexCoordinate&gt;();
                    for (HexCoordinate? step = to; step is not null; step = previous[step.Value]) path.Add(step.Value);
                    path.Reverse();
                    return path;
                }
                frontier.Enqueue(neighbor);
            }
        }

        return [];
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o65473fbceeef46ccabe353453d5d8bef35" cid="OP007" name="CreateDemoMap" creation-date="11/04/2026 08:41:07" type="HexMap" type-id="Class:7b02199936da4c2ebd0acdc41f5cac40" visibility="public" static="true">
                          <parameters>
                            <parameter id="p745a1a5cf99240fba3a6bcc64b0f6cfd" name="columns" type="int" type-id="CSharp.int" default-value="15" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p4b9b7b50d29242398fa3520f05c41075" name="rows" type="int" type-id="CSharp.int" default-value="12" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tvcc6547089eb641e08c8c5b4f7a0c3c77" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="CreateDemoMap" />
                            <tagged-value id="tv275c2649a1a047258cfa7deb053409f3" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\World\HexMap.cs" />
                            <tagged-value id="tv8224f47b487a4e44bd407fd22a2faaa5" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv3557183e98904805b53250558c1886bf" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3042" />
                            <tagged-value id="tv60b4806124c340e7978e989a75b7f844" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1585" />
                          </tagged-values>
                          <documentations>
                            <doc id="4e636f3c03e045d48643c448891dc47d">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Göz Kulesi bölgesi rastgele encounter atmaz; buraya girildiğinde savaş kesindir.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        var map = new HexMap();
        var start = new HexCoordinate(0, 0);
        int halfColumns = columns / 2;
        int halfRows = rows / 2;
        for (int row = 0; row &lt; rows; row++)
            for (int column = 0; column &lt; columns; column++)
            {
                int r = row - halfRows;
                int offsetColumn = column - halfColumns;
                int q = offsetColumn - (int)Math.Floor(r / 2d);
                var coordinate = new HexCoordinate(q, r);
                Biome biome = BiomeCenters.MinBy(x =&gt; x.Center.DistanceTo(coordinate)).Biome;
                int distance = coordinate.DistanceTo(start);
                var tile = new HexTile(coordinate, biome, 1 + Math.Abs(q + r) % 3)
                {
                    IsDangerous = distance &gt;= 2 &amp;&amp; Math.Abs(q * 7 + r * 11) % 4 == 0,
                    HasQuest = q == 2 &amp;&amp; r == -1,
                    SceneId = $"route-{biome.ToString().ToLowerInvariant()}"
                };
                map.Add(tile);
            }

        ConfigureTerrainBarriers(map);
        SealPurpleRegion(map);
                                                                                           
        if (map.Get(EyeTower) is HexTile eyeTower)
        {
            eyeTower.IsLocked = false;
            eyeTower.IsDangerous = true;
            eyeTower.IsForcedCombat = true;
            eyeTower.HasQuest = true;
            eyeTower.SceneId = "eye-tower";
        }
        map.RevealAll();
        return map;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o76bd735b00fe4b94a51fc7ea4bd87c7835" cid="OP008" name="ConfigureTerrainBarriers" creation-date="11/04/2026 08:41:07" type="" type-id="" visibility="private" static="true">
