                        <tagged-value id="tv92d73abc023d47d2aa292378e5b96291" name="namespace" type="text" multiple="false" hidden="false" value="RetroRpg.Core.Items" />
                        <tagged-value id="tvf07c4dd3c0394b2ebc917ccf23a4a466" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="ShopService" />
                        <tagged-value id="tvdda4414485834701a577943da8ba0936" name="SourceCodeGroup" type="reference" multiple="false" hidden="true" ref="p01c8fc639e804c89b9a7f7714c943401_493370883" />
                        <tagged-value id="tv3abce0622662459cafa56fb231cee727" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Items\ShopCatalog.cs" />
                        <tagged-value id="tvf4005090cb834c718a72a1e09b2696bd" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                        <tagged-value id="tvb1db3eb1894a4daab8c602f72cdb7cec" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3451" />
                        <tagged-value id="tvd8331b9358174f83ace7f04c59a28844" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1312" />
                        <tagged-value id="tvbcaacd522c6346579195119e9805911c" name="SourceCodeFileSize" type="text" multiple="false" hidden="true" value="4845" />
                        <tagged-value id="tv1cd9c9317c8b47c4abbc20a84d3f2a68" name="SourceCodeFileChangeDate" type="text" multiple="false" hidden="true" value="11/01/2026 14:24:28" />
                      </tagged-values>
                      <operations>
                        <operation id="oedbac641804b48e6ab7d32aadc29e04276" cid="OP051" name="TryPurchase" creation-date="11/04/2026 08:41:07" type="bool" type-id="CSharp.bool" visibility="public">
                          <parameters>
                            <parameter id="p9384b214ba9946c4a47bf55c8537f724" name="player" type="PlayerCharacter" type-id="PlayerCharacter" creation-date="11/04/2026 08:41:07" />
                            <parameter id="paf4f0b1a0e7441439a1bb04cee08897f" name="offer" type="ShopOffer" type-id="ShopOffer" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p30f1595758ba413b8f17a3f62a38a3ed" name="price" type="int" type-id="CSharp.int" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p0b5be5943b044f18adcf53961eba30a1" name="message" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" direction="Out" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv2014ed15c30642deb4553631a1fa06c3" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="TryPurchase" />
                            <tagged-value id="tv4e42f1f793b84e28bdb862c1b3e682c8" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Items\ShopCatalog.cs" />
                            <tagged-value id="tv9971fddcda9f4d5cbfbb3bf2804e4896" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv2603f68cf2514a9aad4b680c8469b85e" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3644" />
                            <tagged-value id="tv40c7352e1ad342099332e9ad871c00d5" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="445" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        price = Math.Max(1, price);
        if (player.Gold &lt; price)
        {
            message = $"Yetersiz altın. {price} altın gerekiyor.";
            return false;
        }

        player.Gold -= price;
        player.Inventory.Add(offer.CreateItem());
        message = $"{offer.Name} envantere eklendi.";
        return true;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o589359c97ece473badc14ffc030a2e9776" cid="OP052" name="TrySell" creation-date="11/04/2026 08:41:07" type="bool" type-id="CSharp.bool" visibility="public">
                          <parameters>
                            <parameter id="p3067bbeec22143a88763fe3444d7428f" name="player" type="PlayerCharacter" type-id="PlayerCharacter" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p454913fc6bbe4dd4abb2b79ae6d24ba9" name="item" type="Item" type-id="Item" creation-date="11/04/2026 08:41:07" />
                            <parameter id="pee11aa11f866413f94c163f353397936" name="message" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" direction="Out" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv302fb15636d5409cac7a85863117342a" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="TrySell" />
                            <tagged-value id="tvb4fa3babc82a4b078c6a9a4a8f22dba6" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Items\ShopCatalog.cs" />
                            <tagged-value id="tv69dcefe052c34f6f8ec766c635632678" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvd8743763bdfc4038a6e5cf3d37a303ec" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="4164" />
                            <tagged-value id="tv5c59220a0af54c2c8cfb8dbe17b3e97a" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="597" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        if (!player.Inventory.Items.Contains(item))
        {
            message = "Bu eşya envanterde değil.";
            return false;
        }
        if (!item.CanBeSold)
        {
            message = "Görev ve kimlik eşyaları satılamaz.";
            return false;
        }

        player.Equipment.Unequip(item);
        player.Inventory.Remove(item);
        int price = SellPrice(item);
        player.Gold += price;
        message = $"{item.Name} {price} altına satıldı.";
        return true;
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
