                                    <p>
                                      <t> Olay biter: tek-sefer bilgisi yazılır ve sıradaki zincir olayı seçilir.
</t>
                                    </p>
                                  </paragraph>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Sıradaki olay kayda yazılır; böylece autosave'den devam edilince aynı noktadan sürer.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        storyEvent.Complete(session);
        StoryEvent? next = storyEvent.Next.Select(StoryCatalog.Find).OfType&lt;StoryEvent&gt;().FirstOrDefault(x =&gt; x.CanTrigger(session));
        session.Story.ActiveNodeId = next?.Id;
        return next;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o3b48f2153aa74e96bed0d972628d788954" cid="OP024" name="ChooseEnding" creation-date="11/04/2026 08:41:07" type="StoryOutcome" type-id="Class:a97b1b9d203b4dfabdb10cc8df7ef393" visibility="public" static="true">
                          <parameters>
                            <parameter id="p5dc602b35af54a6d998076f18b480fc1" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p7f73236d8ec7472db11b2ad4162c99b8" name="vaelorFate" type="VaelorState" type-id="VaelorState" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p3bef98d866dd430aa922743905d643d4" name="ending" type="EndingStoryEvent" type-id="EndingStoryEvent" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv16070d5f199c4afeab8e11c6206edf8d" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="ChooseEnding" />
                            <tagged-value id="tvc8fa668b22ab452e8f467e923c88e963" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryDirector.cs" />
                            <tagged-value id="tve12a590217004df083c3c8e28af5f34b" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tve814a1cfd50d4c59afc21b7a0c10fce9" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="3173" />
                            <tagged-value id="tv1d222c70192d4615a9aec22841e2f8f1" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="1010" />
                          </tagged-values>
                          <documentations>
                            <doc id="6c21759edeaf4007b5ee24933f6425f2">
                              <text>
                                <default>
                                  <style font-name="Verdana" font-size="12">
                                    <text>
                                      <solid-brush color="#FF000000" />
                                    </text>
                                  </style>
                                </default>
                                <styles />
                                <content>
                                  <paragraph>
                                    <style />
                                    <p>
                                      <t> Final kararı: önce Vaelor'un kaderi, sonra açık finallerden biri. Kilitli final seçilemez.
</t>
                                    </p>
                                  </paragraph>
                                </content>
                              </text>
                            </doc>
                          </documentations>
                          <source-codes>
                            <source-code language="CSharp">
        if (!ending.CanTrigger(session)) throw new InvalidOperationException("Final kararı için Vaelor gerçek savaşta yenilmelidir.");
        if (vaelorFate is not (VaelorState.Killed or VaelorState.Persuaded or VaelorState.Imprisoned))
            throw new ArgumentOutOfRangeException(nameof(vaelorFate));
        if (vaelorFate == VaelorState.Persuaded &amp;&amp; !EndingRules.CanPersuadeVaelor(session.Story))
            throw new InvalidOperationException("Vaelor'u ikna etmek için kurtarılan tanık veya uzlaşmacı kararlar gerekir.");
        if (!ending.IsUnlocked(session.Story)) throw new InvalidOperationException($"{ending.Title} finali kilitli.");

        session.Story.VaelorState = vaelorFate;
        StoryOutcome outcome = ending.Resolve(session, StoryChoice.Continue(), null);
        ending.Complete(session);
        session.Story.ActiveNodeId = null;
        return outcome;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="o649f91f247eb442dbfe39b05a5f8ffdf55" cid="OP025" name="Markers" creation-date="11/04/2026 08:41:07" type="IReadOnlyList&lt;StoryMarker&gt;" type-id="IReadOnlyList&lt;StoryMarker&gt;" visibility="public" static="true">
