                            <tagged-value id="tva071ee6326be462ba717b7d2a8e74778" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Load" />
                            <tagged-value id="tvc5f887b1543f4b02ab85132e5e65ceb2" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\HexTilesetCatalog.cs" />
                            <tagged-value id="tva202116852854672850c793a0523ed9e" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv5c8a397f48da4679a00624378f22810d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="672" />
                            <tagged-value id="tvbf9ade6355ce49e087f975ae56f6cae0" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="879" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        var catalog = new HexTilesetCatalog();
        foreach (Biome biome in Enum.GetValues&lt;Biome&gt;())
        {
            string name = biome.ToString().ToLowerInvariant();
            string folder = $"tilesets/{name}-v1";
            string manifestPath = Path.Combine(assetRoot, folder, "manifests", $"{name}-hex-tileset-v1.json");
            HexTilesetManifest manifest = JsonSerializer.Deserialize&lt;HexTilesetManifest&gt;(File.ReadAllText(manifestPath), JsonOptions.Default)
                ?? throw new InvalidDataException($"Tileset manifesti okunamadı: {manifestPath}");
            catalog._baseTiles[biome] = manifest.Tiles
                .Where(x =&gt; x.Category == "base" &amp;&amp; x.Passable)
                .Select(x =&gt; $"{folder}/{x.Image}")
                .ToArray();
        }
        return catalog;
    </source-code>
                          </source-codes>
                        </operation>
                        <operation id="of3ef6a6e923441b4b40e96d0abb495e5116" cid="OP084" name="BaseTilePath" creation-date="11/04/2026 08:41:07" type="string" type-id="CSharp.string" visibility="public">
                          <parameters>
                            <parameter id="p6815aa3bb4704ab8a787059790b98014" name="biome" type="Biome" type-id="Biome" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p003b1a8fd06841428d89ef04dffcfb6b" name="coordinate" type="HexCoordinate" type-id="HexCoordinate" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv40e5b7f7b86a469d8346bbe4242d61f4" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="BaseTilePath" />
                            <tagged-value id="tv535bbbb5d715405c899585547c529847" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Rendering\HexTilesetCatalog.cs" />
                            <tagged-value id="tv46cdc05c77e24061928b2b9f6e277ef9" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tv8681ede73fd34091bfc988b37ee6591d" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="1557" />
                            <tagged-value id="tv9d5a6c611f21487992f28a24e9b508c4" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="244" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        string[] tiles = _baseTiles[biome];
        int seed = Math.Abs(coordinate.Q * 73856093 ^ coordinate.R * 19349663);
        return tiles[seed % tiles.Length];
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
