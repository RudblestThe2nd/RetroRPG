                      <tagged-values>
                        <tagged-value id="tv30d4f0594ea84458b62963a2e5366363" name="namespace" type="text" multiple="false" hidden="false" value="RetroRpg.Core.Story" />
                        <tagged-value id="tv918b0a6c90094b2cadf581e43e20a2bd" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="SkillCheckStoryEvent" />
                        <tagged-value id="tv281dd2069aef40389b594df2767536b6" name="SourceCodeGroup" type="reference" multiple="false" hidden="true" ref="p01c8fc639e804c89b9a7f7714c943401_493370883" />
                        <tagged-value id="tv64602bfb9827488f90b08679d112a4a4" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryEvent.cs" />
