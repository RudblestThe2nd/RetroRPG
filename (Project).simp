                      <documentations>
                        <doc id="7055785d3e9149e6b9610041bc6965ba">
                          <text>
                            <default>
                              <style font-name="Verdana" font-size="12">
                                <text>
                                  <solid-brush color="#FF000000" />
                                </text>
                              </style>
                            </default>
                            <styles />
                            <content>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Ödevin kalıtım hedefini sade tutan başlangıç ekipmanı ailesi.
</t>
                                </p>
                              </paragraph>
                              <paragraph>
                                <style />
                                <p>
                                  <t> Her alt paket yalnız değişen eşyaları seçer; verme davranışı taban sınıftadır.
</t>
                                </p>
                              </paragraph>
                            </content>
                          </text>
                        </doc>
