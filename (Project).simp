                        <operation id="oe90483c649ce41d6a46381095a2f2e7247" cid="OP017" name="Apply" creation-date="11/04/2026 08:41:07" type="StoryOutcome" type-id="Class:a97b1b9d203b4dfabdb10cc8df7ef393" visibility="protected">
                          <parameters>
                            <parameter id="pe9616647fc7e4f47a6967f28852d00f1" name="session" type="GameSession" type-id="GameSession" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p7e71124f64354e5f81d830447f26f127" name="success" type="bool" type-id="CSharp.bool" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p8f3b3625cf1645dd921b364121fa4411" name="text" type="string" type-id="CSharp.string" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p2d879ee63a2d48389de35035f03fc25b" name="chosen" type="IReadOnlyList&lt;StoryConsequence&gt;" type-id="IReadOnlyList&lt;StoryConsequence&gt;" creation-date="11/04/2026 08:41:07" />
                            <parameter id="p2232f97cd91447feb502b9c70cf43ad5" name="roll" type="D20Roll" type-id="D20Roll" creation-date="11/04/2026 08:41:07" />
                          </parameters>
                          <tagged-values>
                            <tagged-value id="tv095d81655cff4304991b4ded211ca7c2" name="ReverseEngineered" type="text" multiple="false" hidden="true" value="Apply" />
                            <tagged-value id="tvd67c4f7962314acb928250325e50fb0f" name="SourceCodePath" type="text" multiple="false" hidden="true" value="C:\Users\VECTUS\Documents\pc\game_design\src\RetroRpg.Core\Story\StoryEvent.cs" />
                            <tagged-value id="tvdd983fe0d2bf414a9e22673fd80c6909" name="SourceCodeLanguage" type="text" multiple="false" hidden="true" value="CSharp" />
                            <tagged-value id="tvb0a95c44c4894638b1bbb9186bb20c82" name="SourceCodePosition" type="text" multiple="false" hidden="true" value="5289" />
                            <tagged-value id="tv1c9449ca5c744800831b45da0247a544" name="SourceCodeLength" type="text" multiple="false" hidden="true" value="390" />
                          </tagged-values>
                          <source-codes>
                            <source-code language="CSharp">
        IReadOnlyList&lt;StoryConsequence&gt; all = chosen.Concat(Always).ToArray();
        foreach (StoryConsequence consequence in all) consequence.Apply(session);
        return new StoryOutcome(success, StoryText.Format(session, text), all, roll);
    </source-code>
                          </source-codes>
                        </operation>
                      </operations>
                    </item>
